{
  "name": "rulescope",
  "version": "0.0.0",
  "description": "Show which instruction files, rules and skills Claude Code, Codex and Cursor will load for a directory, in the terminal or as an HTML report",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "agents-md",
    "claude-md",
    "cursor-rules",
    "skills",
    "ai-agents",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rulescope": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && publint",
    "prepublishOnly": "npm run check",
    "release": "changeset publish"
  },
  "sideEffects": false,
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosminog/rulescope.git"
  },
  "homepage": "https://github.com/kosminog/rulescope#readme",
  "bugs": {
    "url": "https://github.com/kosminog/rulescope/issues"
  },
  "author": "Daniel Turkov"
}
